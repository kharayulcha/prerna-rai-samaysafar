{
  "compilerOptions": {
    // Output & Root
    "rootDir": "src",
    "outDir": "./dist",
    // Module system (REQUIRED for ESM)
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // Target modern JS
    "target": "ES2020",
    "lib": [
      "ES2020"
    ],
    // Node typings
    "types": [
      "node"
    ],
    // Source maps & declarations
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    // Strict mode
    "strict": true,
    // React (not used in backend but keeping your config)
    "jsx": "react-jsx",
    // Must stay true but works only if package.json has "type": "module"
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedSideEffectImports": true,
    // Helpful for speed
    "skipLibCheck": true,
    // Interop with CommonJS
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    // Forces TypeScript to treat all files as modules
    "moduleDetection": "force"
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "prisma.config.ts"
  ]
}